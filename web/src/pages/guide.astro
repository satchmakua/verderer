---
import Base from '../layouts/Base.astro';
import { record, STATE_HELP, STATE_NAMES, STATE_ORDER, summary } from '../lib/record';

const states = STATE_ORDER.map((code) => ({ code, name: STATE_NAMES[code], help: STATE_HELP[code] }));
const types = [
  { name: 'No longer served', type: 'Deletion', severity: 'High', means: 'The address answered normally and now returns an error or a refusal.' },
  { name: 'Served again', type: 'Reappearance', severity: 'Medium', means: 'An address that was returning an error is being served again. Its content is compared with the last version that was served.' },
  { name: 'Watched term removed', type: 'TermSubstitution', severity: 'High', means: 'A term on the watch list was on the page and now is not there at all.' },
  { name: 'Watched term appeared, or its count changed', type: 'TermSubstitution', severity: 'Medium', means: 'A watched term appears where it did not, or is mentioned more or fewer times.' },
  { name: 'Regulatory number changed', type: 'NumericThresholdChange', severity: 'High', means: 'A number with a unit, next to regulatory wording such as “limit” or “level”, has a different value.' },
  { name: 'Text edited, added or removed', type: 'ContentEdit', severity: 'Medium', means: 'A passage — a list item, a heading, a table cell — reads differently, and no watched term or number was involved.' },
  { name: 'Page text changed', type: 'ContentEdit', severity: 'Medium', means: 'The text changed too broadly to pin on one passage. The two captures show exactly how.' },
  { name: 'Dataset structure changed', type: 'SchemaChange', severity: 'High / Medium', means: 'A column, sheet, file or variable was removed (High), or added or retyped (Medium).' },
  { name: 'Dataset values shifted', type: 'DistributionalShift', severity: 'High', means: 'The row count changed, or a column’s numbers moved in aggregate — a re-baselining or a truncation.' },
  { name: 'Status, address or metadata changed', type: 'MetadataChange', severity: 'Medium', means: 'An unavailable source started failing differently, requests now end at a different address, or a dataset’s attributes changed.' },
];
---

<Base title="Verderer — how to read this record" active="guide">
  <h1>How to read this record</h1>
  <p class="lede">
    Verderer watches a small, curated set of U.S. government environmental pages and datasets. This page
    explains what it records, what its labels mean, how much of it is proven — and how to check that for
    yourself.
  </p>

  <h2 id="works">What it does</h2>
  <ol>
    <li>
      <strong>It checks each source on a schedule</strong> — politely, obeying each site’s robots.txt and rate
      limits. Sources are re-checked several times a day.
    </li>
    <li>
      <strong>It records every distinct response.</strong> The exact bytes received are stored and their
      fingerprint is appended to a signed, append-only log. A re-check that returns the same bytes adds
      nothing.
    </li>
    <li>
      <strong>It compares each new version with the one before</strong> and lists what moved: a watched term,
      a number with a unit, a passage of text, a column of data, or whether the source is served at all.
    </li>
    <li>
      <strong>It publishes everything</strong> — this site, a machine-readable record, RSS feeds, the captures
      themselves, and proofs anyone can verify offline.
    </li>
  </ol>

  <h2 id="changes">Changes and findings</h2>
  <p>
    A <strong>change</strong> is one comparison between two recorded versions of a source. Everything found in
    that comparison is a <strong>finding</strong>, so a change that removed two terms and lowered the count of
    a third has three findings and one headline.
  </p>
  <p>
    When a list gains or loses an item, everything after it shifts position, and a position-by-position
    comparison reports each shifted item as an edit. Verderer cancels those out and shows the net effect —
    what was actually added or removed — with the original findings one click away.
  </p>
  <p>
    If a later change puts back exactly what an earlier one altered, the two are linked as a reversal. Both
    stay on the record: that something was changed and then changed back is itself information.
  </p>

  <h2 id="severity">Severity</h2>
  <p>
    Severity is a rule-based triage label that says how closely a change matches the patterns this project
    exists to catch. It is not a judgment about intent, or about how much a change matters.
  </p>
  <div class="scroll">
    <table class="data">
      <tbody>
        <tr>
          <td><span class="sev high">High</span></td>
          <td>Something was taken away or a regulated value moved: a watched term vanished, a number with a unit changed, a dataset lost a column or rows, a source stopped being served.</td>
        </tr>
        <tr>
          <td><span class="sev med">Medium</span></td>
          <td>A real change that needs a human reading: text was edited, a watched term’s count shifted, something was added, a source came back.</td>
        </tr>
        <tr>
          <td><span class="sev low">Low</span></td>
          <td>Rewording that leaves the meaning close to what it was.</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="types">Kinds of change</h2>
  <div class="scroll">
    <table class="data">
      <thead><tr><th>What you will see</th><th>Means</th><th>Usual severity</th><th>Logged as</th></tr></thead>
      <tbody>
        {types.map((t) => (
          <tr>
            <td><strong>{t.name}</strong></td>
            <td>{t.means}</td>
            <td class="nowrap">{t.severity}</td>
            <td><code>{t.type}</code></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  {record.watchedTerms.length > 0 && (
    <details style="margin-top:12px">
      <summary>The {record.watchedTerms.length} watched terms</summary>
      <p class="small muted" style="margin-top:8px">
        Each earned its place by a documented history of being removed or substituted, or by naming a legal
        concept whose wording shifts obligations.
      </p>
      <p>{record.watchedTerms.map((term) => <span class="tag" style="margin:0 6px 6px 0">{term}</span>)}</p>
    </details>
  )}

  <h2 id="states">Source states</h2>
  <div class="scroll">
    <table class="data">
      <tbody>
        {states.map((s) => (
          <tr>
            <td class="nowrap"><span class={`chip ${s.code}`}>{s.name}</span></td>
            <td>{s.help}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small muted" style="margin-top:10px">
    A refusal is recorded as what this collector was told. It does not show that other visitors are refused,
    or what the page says to them.
  </p>

  <h2 id="churn">Error-page churn</h2>
  <p>
    When a server refuses the collector, the body it sends is its error page, not the source. Some error pages
    change on every request — an “access denied” page that prints a new reference number, for instance. Each
    is a distinct response and is recorded, but comparing two error pages says nothing about the source, so
    these are set aside rather than reported as changes.
    {summary.error_page_churn > 0 && (
      <> This record holds {summary.error_page_churn} of them from before that rule was in place; they are
      kept, labelled, and left out of the counts and feeds.</>
    )}
  </p>

  <h2 id="proof">What is proven, and what is not</h2>
  <div class="grid cols-3">
    <div class="card">
      <h3>Proven</h3>
      <p class="small">
        That the collector received <em>this response</em> — these exact bytes, this status — from
        <em>this address</em>, and logged it at <em>this time</em>; and that the log has not been rewritten
        since. Recorded responses and findings are entries in a signed, append-only log.
      </p>
    </div>
    <div class="card">
      <h3>Interpretation</h3>
      <p class="small">
        Headlines, severities, change types, a source’s state, and which changes count as notable. They are
        derived from the proven entries by published rules, are best-effort, and can be re-derived or
        disputed.
      </p>
    </div>
    <div class="card">
      <h3>The operator’s report</h3>
      <p class="small">
        When a source was last checked, and that a check failed. A look that finds nothing new — or gets no
        answer — leaves no entry to sign, so this is the watchdog’s own account, not a proof.
      </p>
    </div>
  </div>
  <p style="margin-top:14px"><strong>Verderer does not claim</strong>:</p>
  <ul>
    <li>that a response is what the agency “really” published, or what any other visitor was served;</li>
    <li>anything about a source before its first recorded response;</li>
    <li>why a change was made, or by whom;</li>
    <li>that a time is exact — times are the collector’s clock, bounded from outside only where a proof carries an independent timestamp.</li>
  </ul>

  <h2 id="verify">Verify it yourself</h2>
  <ol>
    <li>Open any source and choose <strong>Verify the latest proof</strong>, or download its proof bundle.</li>
    <li>
      The <a href="/verify">verifier</a> runs entirely in your browser. It checks that the captured bytes
      match the recorded fingerprint, that the record is in the signed log, and that the log is signed by
      Verderer’s published key. Nothing is uploaded.
    </li>
    <li>
      To check without this site at all, run the open-source verifier on the downloaded file:
      <code>verderer-verify bundle proof.json</code>.
    </li>
  </ol>
  {record.publicKey && (
    <p class="small">
      The log’s public key — also published in the
      <a href="https://github.com/satchmakua/verderer#pin-the-logs-key">project README</a>, so it can be
      pinned from a second place:<br />
      <code>{record.publicKey}</code>
      <button class="copy" type="button" data-copy={record.publicKey}>copy</button>
    </p>
  )}

  <h2 id="data">Data and feeds</h2>
  <div class="scroll">
    <table class="data">
      <tbody>
        <tr><td><a href="/record.json">record.json</a></td><td>The whole record, machine-readable. Its <code>legend</code> entry states which fields are proven, interpreted, or operator-reported.</td></tr>
        <tr><td><a href="/feed.xml">feed.xml</a></td><td>RSS of every change. Each source also has its own feed, linked from its page.</td></tr>
        <tr><td><a href="/checkpoint">checkpoint</a></td><td>The log’s current signed head: its size and root fingerprint.</td></tr>
        <tr><td><code>/tile/…</code></td><td>The log itself, as standard tiles — enough to recompute any proof without asking this site.</td></tr>
        <tr><td><code>/warc/…</code></td><td>Every recorded response as a standard web-archive file, readable by any archive tool.</td></tr>
        <tr><td><code>/bundles/…</code></td><td>A self-verifying proof bundle for each source’s latest recorded response.</td></tr>
      </tbody>
    </table>
  </div>

  <h2 id="glossary">Glossary</h2>
  <dl class="facts" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">
    <div><dt>Recorded response</dt><dd style="font-weight:400">One fetch of a source: the bytes received, the status, the final address, and the time — signed into the log.</dd></div>
    <div><dt>Content hash</dt><dd style="font-weight:400">A fingerprint of the exact bytes received. Change one byte and it changes completely.</dd></div>
    <div><dt>Signed log</dt><dd style="font-weight:400">An append-only list of entries whose head is signed. Entries can be added, never altered or removed, without the signature chain exposing it.</dd></div>
    <div><dt>Checkpoint</dt><dd style="font-weight:400">The signed statement of the log’s size and root at a moment in time.</dd></div>
    <div><dt>Proof bundle</dt><dd style="font-weight:400">One file holding a recorded response, its bytes, and the proof that it is in the signed log — checkable offline.</dd></div>
    <div><dt>WARC</dt><dd style="font-weight:400">The standard file format web archives use for a captured request and response.</dd></div>
  </dl>
</Base>
