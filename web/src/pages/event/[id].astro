---
// A single finding's permanent page. A finding is one item the differ reported; the change it
// belongs to gathers everything found in the same comparison.
import Base from '../../layouts/Base.astro';
import Finding from '../../components/Finding.astro';
import When from '../../components/When.astro';
import type { Finding as FindingT } from '../../lib/record';
import { changeById, events, plural, titleOf } from '../../lib/record';

export function getStaticPaths() {
  return events.map((e) => ({ params: { id: e.id }, props: { finding: e } }));
}
const { finding } = Astro.props as { finding: FindingT };
const change = changeById(finding.change_id);
const title = finding.explain?.title ?? finding.diff_type;
---

<Base title={`Verderer — ${title}`} description={`${titleOf(finding.target_id)}: ${title}`} active="changes">
  <div class="crumbs">
    <a href="/">Overview</a> / <a href="/changes">Changes</a> /
    <a href={`/target/${finding.target_id}`}>{titleOf(finding.target_id)}</a>
  </div>
  <p class="eyebrow">Finding detected <When iso={finding.detected_at} time rel="never" /></p>
  <h1>{title}</h1>
  <p>on <a href={`/target/${finding.target_id}`}>{titleOf(finding.target_id)}</a></p>

  <div class="card">
    <Finding finding={finding} link={false} />
  </div>

  {change && (
    <div class="callout">
      <p>
        This is {change.event_ids.length === 1 ? 'the only finding' : `one of ${plural(change.event_ids.length, 'finding')}`}
        from a single comparison of two recorded versions.
        <a href={`/change/${change.id}`}>See the whole change, both versions, and how to verify them →</a>
      </p>
    </div>
  )}

  <p class="small muted">
    This classification is a best-effort, human-reviewable interpretation — not a verified fact. What is
    verifiable is that the two versions it compares were recorded when and where the log says.
  </p>
  <p class="small muted">
    Permanent id <code>{finding.id}</code>
    <button class="copy" type="button" data-copy={finding.id}>copy</button>
  </p>
</Base>
