---
import Base from '../../layouts/Base.astro';
import WeekDigest from '../../components/WeekDigest.astro';
import { record, weekSpan, weeks } from '../../lib/record';
import When from '../../components/When.astro';

const current = weeks[0];
const earlier = weeks.slice(1);
---

<Base
  title="Verderer — weekly digest"
  description="What changed this week in the government environmental pages and datasets Verderer watches."
  active="digest"
>
  <h1>Weekly digest</h1>
  <p class="lede">
    What changed, one week at a time. A week runs Monday to Sunday (UTC); the most important changes come
    first. Prefer it delivered? Subscribe to the <a href="/digest.xml">weekly feed</a> — one item when each
    week closes.
  </p>

  {current ? (
    <>
      <h2 class="week-title">
        {current.complete ? 'Latest week' : 'This week so far'}
        <span class="muted"> · {weekSpan(current)}</span>
      </h2>
      {!current.complete && (
        <p class="small muted">
          Still in progress — as of <When iso={record.generatedAt} time />. <a href={`/digest/${current.id}`}>Permanent link to this week</a>
        </p>
      )}
      <WeekDigest week={current} />

      {earlier.length > 0 && (
        <>
          <h2>Earlier weeks</h2>
          <div class="scroll">
            <table class="data">
              <thead>
                <tr><th>Week</th><th>What changed</th><th class="num">High</th><th class="num">Responses</th></tr>
              </thead>
              <tbody>
                {earlier.map((week) => (
                  <tr>
                    <td class="nowrap"><a href={`/digest/${week.id}`}>{weekSpan(week)}</a></td>
                    <td class={week.changes === 0 ? 'muted' : ''}>{week.summary}</td>
                    <td class="num">{week.notable > 0 ? <span class="sev high">{week.notable}</span> : <span class="muted">—</span>}</td>
                    <td class="num">{week.observations}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
    </>
  ) : (
    <p class="muted">No response has been recorded yet, so there is no week to report.</p>
  )}

  <style>
    .week-title { margin-bottom: 4px; }
    td.num, th.num { text-align: right; }
  </style>
</Base>
