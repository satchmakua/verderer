---
interface Props {
  title: string;
  description?: string;
  active?: 'overview' | 'changes' | 'guide' | 'verify' | 'overlay';
}
const {
  title,
  description = 'A verifiable, tamper-evident record of what U.S. government environmental data said, and how it is being changed.',
  active,
} = Astro.props;

const nav = [
  { id: 'overview', href: '/', label: 'Overview' },
  { id: 'changes', href: '/changes', label: 'Changes' },
  { id: 'guide', href: '/guide', label: 'How to read this' },
  { id: 'verify', href: '/verify', label: 'Verify' },
  { id: 'overlay', href: '/overlay', label: 'Archives' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Verderer — all changes" href="/feed.xml" />
    <script is:inline>
      // Apply a saved theme before first paint (no flash). Storage can be unavailable; ignore.
      try {
        const saved = localStorage.getItem('verderer-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <style is:global>
      :root {
        --bg: #f6f7f9; --surface: #ffffff; --surface-2: #eef1f4; --ink: #17212b; --ink-2: #3f4b58;
        --muted: #606c79; --line: #dde2e8; --line-strong: #c3cbd4; --accent: #0a6480; --accent-ink: #ffffff;
        --high: #a8231c; --high-bg: #fdecea; --med: #7d5200; --med-bg: #fff3d1; --low: #55616e; --low-bg: #e9edf1;
        --ok: #17703f; --ok-bg: #e2f4ea; --warn: #7d5200; --warn-bg: #fff3d1; --bad: #a8231c; --bad-bg: #fdecea;
        --idle: #55616e; --idle-bg: #e9edf1; --ins-bg: #d6f1df; --del-bg: #fbdad7;
        --shadow: 0 1px 2px rgba(16, 24, 32, .06);
        --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #0f1216; --surface: #171b21; --surface-2: #1e242c; --ink: #e7ecf2; --ink-2: #c4cdd8;
          --muted: #97a3b2; --line: #283241; --line-strong: #3b4758; --accent: #77c0d6; --accent-ink: #0b1014;
          --high: #ff8f85; --high-bg: #3a1715; --med: #f1c466; --med-bg: #33280e; --low: #a6b1be; --low-bg: #232b34;
          --ok: #70d7a2; --ok-bg: #112a1e; --warn: #f1c466; --warn-bg: #33280e; --bad: #ff8f85; --bad-bg: #3a1715;
          --idle: #a6b1be; --idle-bg: #232b34; --ins-bg: #173d27; --del-bg: #4c1e1b;
          --shadow: none;
        }
      }
      :root[data-theme='dark'] {
        --bg: #0f1216; --surface: #171b21; --surface-2: #1e242c; --ink: #e7ecf2; --ink-2: #c4cdd8;
        --muted: #97a3b2; --line: #283241; --line-strong: #3b4758; --accent: #77c0d6; --accent-ink: #0b1014;
        --high: #ff8f85; --high-bg: #3a1715; --med: #f1c466; --med-bg: #33280e; --low: #a6b1be; --low-bg: #232b34;
        --ok: #70d7a2; --ok-bg: #112a1e; --warn: #f1c466; --warn-bg: #33280e; --bad: #ff8f85; --bad-bg: #3a1715;
        --idle: #a6b1be; --idle-bg: #232b34; --ins-bg: #173d27; --del-bg: #4c1e1b;
        --shadow: none;
      }

      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.6 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
      code, .mono { font-family: var(--mono); font-size: .9em; }
      code { background: var(--surface-2); padding: 1px 5px; border-radius: 4px; overflow-wrap: anywhere; }
      [hidden] { display: none !important; }
      .wrap { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
      .muted { color: var(--muted); }
      .small { font-size: 14px; }
      .nowrap { white-space: nowrap; }

      /* --- shell --- */
      header.site { background: var(--surface); border-bottom: 1px solid var(--line); }
      header.site .wrap { display: flex; align-items: center; gap: 8px 20px; padding-top: 12px; padding-bottom: 12px; flex-wrap: wrap; }
      header.site .mark { font-weight: 800; letter-spacing: .12em; color: var(--ink); font-size: 15px; }
      header.site nav { display: flex; gap: 2px; flex-wrap: wrap; margin-left: auto; }
      header.site nav a { color: var(--ink-2); padding: 6px 10px; border-radius: 6px; font-size: 14.5px; }
      header.site nav a:hover { background: var(--surface-2); text-decoration: none; }
      header.site nav a[aria-current='page'] { color: var(--ink); background: var(--surface-2); font-weight: 600; }
      #theme-toggle { background: none; border: 1px solid var(--line); color: var(--ink-2); border-radius: 6px;
        padding: 5px 9px; font: inherit; font-size: 13px; cursor: pointer; }
      #theme-toggle:hover { background: var(--surface-2); }
      main .wrap { padding-top: 28px; padding-bottom: 64px; }
      footer.site { border-top: 1px solid var(--line); color: var(--muted); font-size: 14px; background: var(--surface); }
      footer.site .wrap { padding-top: 20px; padding-bottom: 36px; display: grid; gap: 10px; }
      footer.site .links { display: flex; gap: 6px 16px; flex-wrap: wrap; }

      /* --- type --- */
      h1 { font-size: clamp(24px, 3.4vw, 32px); line-height: 1.2; margin: 0 0 12px; letter-spacing: -.01em; }
      h2 { font-size: 20px; line-height: 1.3; margin: 40px 0 6px; }
      h3 { font-size: 16.5px; line-height: 1.35; margin: 0 0 4px; }
      p { margin: 0 0 12px; }
      .lede { font-size: 17.5px; color: var(--ink-2); max-width: 68ch; }
      .section-note { color: var(--muted); margin: 0 0 16px; max-width: 76ch; }
      .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 14px; }
      .eyebrow { font-size: 12.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 600; }

      /* --- badges & chips --- */
      .sev { display: inline-flex; align-items: center; padding: 1px 9px; border-radius: 999px; font-size: 12px;
        font-weight: 700; letter-spacing: .03em; text-transform: uppercase; border: 1px solid transparent; white-space: nowrap; }
      .sev.high { color: var(--high); background: var(--high-bg); border-color: color-mix(in srgb, var(--high) 35%, transparent); }
      .sev.med { color: var(--med); background: var(--med-bg); border-color: color-mix(in srgb, var(--med) 35%, transparent); }
      .sev.low { color: var(--low); background: var(--low-bg); border-color: color-mix(in srgb, var(--low) 35%, transparent); }
      .chip { display: inline-flex; align-items: center; gap: 6px; padding: 2px 10px; border-radius: 999px; font-size: 13px;
        font-weight: 600; white-space: nowrap; color: var(--idle); background: var(--idle-bg); }
      .chip::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: currentColor; flex: none; }
      .chip.live { color: var(--ok); background: var(--ok-bg); }
      .chip.blocked, .chip.error { color: var(--warn); background: var(--warn-bg); }
      .chip.gone, .chip.failing { color: var(--bad); background: var(--bad-bg); }
      .tag { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 6px; border: 1px solid var(--line-strong);
        color: var(--ink-2); background: var(--surface); }
      .note-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 13px; padding: 2px 9px; border-radius: 6px;
        background: var(--surface-2); color: var(--ink-2); }

      /* --- surfaces --- */
      .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; box-shadow: var(--shadow); }
      a.card { display: block; color: inherit; }
      a.card:hover { border-color: var(--line-strong); text-decoration: none; }
      .grid { display: grid; gap: 14px; }
      .grid.cols-2 { grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); }
      .grid.cols-3 { grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); }
      .grid.cols-4 { grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); }
      .callout { border: 1px solid var(--line); border-left: 4px solid var(--accent); background: var(--surface);
        border-radius: 8px; padding: 12px 16px; margin: 16px 0; }
      .callout.warn { border-left-color: var(--warn); }
      .callout.bad { border-left-color: var(--bad); }
      .callout.ok { border-left-color: var(--ok); }
      .callout > :last-child { margin-bottom: 0; }

      /* --- status banner & stats --- */
      .status { display: flex; align-items: center; gap: 10px 12px; flex-wrap: wrap; padding: 12px 16px; border-radius: 10px;
        border: 1px solid var(--line); background: var(--surface); margin: 18px 0 14px; }
      .status .dot { width: 11px; height: 11px; border-radius: 50%; background: var(--idle); flex: none; }
      .status[data-tone='ok'] .dot { background: var(--ok); box-shadow: 0 0 0 4px var(--ok-bg); }
      .status[data-tone='warn'] .dot { background: var(--warn); box-shadow: 0 0 0 4px var(--warn-bg); }
      .status[data-tone='bad'] .dot { background: var(--bad); box-shadow: 0 0 0 4px var(--bad-bg); }
      .status[data-tone='warn'] { border-color: color-mix(in srgb, var(--warn) 45%, var(--line)); }
      .status[data-tone='bad'] { border-color: color-mix(in srgb, var(--bad) 55%, var(--line)); background: var(--bad-bg); }
      .stat .value { font-size: 30px; font-weight: 700; line-height: 1.1; letter-spacing: -.01em; }
      .stat .label { color: var(--muted); font-size: 14px; margin-bottom: 6px; }
      .stat .sub { color: var(--ink-2); font-size: 14px; margin-top: 6px; }
      .statebar { display: flex; height: 8px; border-radius: 999px; overflow: hidden; background: var(--idle-bg); margin: 10px 0 8px; gap: 2px; }
      .statebar span { display: block; min-width: 6px; }
      .statebar .live { background: var(--ok); } .statebar .blocked, .statebar .error { background: var(--warn); }
      .statebar .gone, .statebar .failing { background: var(--bad); } .statebar .unreachable, .statebar .excluded, .statebar .pending { background: var(--idle); }
      .legend { display: flex; gap: 4px 12px; flex-wrap: wrap; font-size: 13.5px; color: var(--ink-2); }
      .legend i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; background: var(--idle); }
      .legend .live i { background: var(--ok); } .legend .blocked i, .legend .error i { background: var(--warn); }
      .legend .gone i, .legend .failing i { background: var(--bad); }

      /* --- a change --- */
      .change { border-left: 4px solid var(--line-strong); }
      .change.sev-high { border-left-color: var(--high); }
      .change.sev-med { border-left-color: var(--med); }
      .change .meta { display: flex; align-items: center; gap: 6px 10px; flex-wrap: wrap; font-size: 14px; color: var(--muted); margin-bottom: 6px; }
      .change .meta .src { color: var(--ink-2); font-weight: 600; }
      .change h3 { font-size: 17.5px; margin-bottom: 8px; }
      .change h3 a { color: var(--ink); }
      .change ul.points { margin: 0 0 8px; padding-left: 20px; color: var(--ink-2); }
      .change ul.points li { margin: 3px 0; overflow-wrap: anywhere; }
      .change .foot { display: flex; gap: 6px 14px; flex-wrap: wrap; font-size: 14px; color: var(--muted); margin-top: 8px; }
      .row-change { display: grid; grid-template-columns: 84px minmax(0, 1fr) auto; gap: 10px; align-items: baseline;
        padding: 10px 2px; border-bottom: 1px solid var(--line); }
      .row-change .what { min-width: 0; }
      .row-change .what a.h { color: var(--ink); font-weight: 600; }
      .row-change .what .src { color: var(--muted); font-size: 14px; }
      .row-change time { color: var(--muted); font-size: 14px; white-space: nowrap; }
      .month { margin: 26px 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); font-weight: 700; }

      /* --- a finding --- */
      .finding { padding: 12px 0; border-top: 1px solid var(--line); }
      .finding:first-child { border-top: 0; padding-top: 4px; }
      .finding .ftitle { font-weight: 600; display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap; }
      .finding p { margin: 4px 0 0; color: var(--ink-2); overflow-wrap: anywhere; }
      .delta { display: inline-flex; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: 19px; font-weight: 700; margin: 6px 0 2px; }
      .delta .from { color: var(--muted); text-decoration: line-through; text-decoration-thickness: 1.5px; font-weight: 600; }
      .delta .arrow { color: var(--muted); font-weight: 400; }
      .delta .pct { font-size: 14px; font-weight: 600; color: var(--muted); }
      .textdiff { margin: 8px 0 0; padding: 10px 12px; background: var(--surface-2); border-radius: 8px; font-size: 15px;
        line-height: 1.7; overflow-wrap: anywhere; }
      .textdiff del { background: var(--del-bg); text-decoration: line-through; padding: 1px 3px; border-radius: 3px; }
      .textdiff ins { background: var(--ins-bg); text-decoration: none; padding: 1px 3px; border-radius: 3px; }
      details > summary { cursor: pointer; color: var(--accent); font-size: 14px; }
      details.raw { margin-top: 8px; }
      pre { background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; overflow-x: auto;
        font: 13px/1.5 var(--mono); margin: 8px 0 0; }

      /* --- facts, tables, sources --- */
      dl.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px 20px; margin: 0; }
      dl.facts dt { font-size: 13px; color: var(--muted); }
      dl.facts dd { margin: 2px 0 0; font-weight: 600; overflow-wrap: anywhere; }
      dl.facts dd .sub { display: block; font-weight: 400; font-size: 14px; color: var(--muted); }
      table.data { width: 100%; border-collapse: collapse; font-size: 14.5px; }
      table.data th { text-align: left; font-size: 12.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted);
        font-weight: 600; padding: 8px 10px; border-bottom: 1px solid var(--line-strong); white-space: nowrap; }
      table.data td { padding: 8px 10px; border-bottom: 1px solid var(--line); vertical-align: top; }
      .scroll { overflow-x: auto; }
      .source { display: grid; gap: 8px; }
      .source .top { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
      .source h3 { margin: 0; }
      .source .host { color: var(--muted); font-size: 13.5px; overflow-wrap: anywhere; }
      .source .lines { font-size: 14.5px; color: var(--ink-2); display: grid; gap: 2px; }
      .source .tags { display: flex; gap: 5px; flex-wrap: wrap; }
      .actions { display: flex; gap: 8px; flex-wrap: wrap; margin: 14px 0 0; }
      .btn { display: inline-flex; align-items: center; gap: 6px; padding: 7px 13px; border-radius: 8px; font: inherit;
        font-size: 14.5px; font-weight: 600; border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink);
        cursor: pointer; }
      .btn:hover { background: var(--surface-2); text-decoration: none; }
      .btn.primary { background: var(--accent); color: var(--accent-ink); border-color: var(--accent); }
      .btn.primary:hover { filter: brightness(1.08); }
      .btn:disabled { opacity: .55; cursor: default; }
      button.copy { background: none; border: 0; color: var(--accent); cursor: pointer; font: inherit; font-size: 13px; padding: 0 4px; }

      /* --- filters --- */
      .toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 14px 0 6px; }
      .toolbar input[type='search'], .toolbar select { font: inherit; font-size: 15px; padding: 8px 11px; border-radius: 8px;
        border: 1px solid var(--line-strong); background: var(--surface); color: var(--ink); }
      .toolbar input[type='search'] { flex: 1 1 240px; min-width: 0; }
      .toolbar label.check { display: inline-flex; align-items: center; gap: 7px; font-size: 14.5px; color: var(--ink-2); }
      .seg { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 8px; overflow: hidden; }
      .seg button { font: inherit; font-size: 14.5px; padding: 7px 12px; border: 0; background: var(--surface); color: var(--ink-2);
        cursor: pointer; border-left: 1px solid var(--line); }
      .seg button:first-child { border-left: 0; }
      .seg button[aria-pressed='true'] { background: var(--accent); color: var(--accent-ink); }

      /* --- history strip --- */
      .strip { width: 100%; height: auto; display: block; }
      .strip .axis { stroke: var(--line-strong); stroke-width: 1; }
      .strip text { fill: var(--muted); font: 11px ui-sans-serif, system-ui, sans-serif; }
      .strip .tick.served { stroke: var(--ok); } .strip .tick.blocked { stroke: var(--warn); } .strip .tick.gone { stroke: var(--bad); }
      .strip .mark.high { fill: var(--high); } .strip .mark.med { fill: var(--med); } .strip .mark.low { fill: var(--low); }
      .strip .mark { stroke: var(--surface); stroke-width: 1.5; }

      @media (max-width: 640px) {
        .row-change { grid-template-columns: 1fr; gap: 3px; }
        header.site nav { margin-left: 0; }
        .stat .value { font-size: 26px; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="mark" href="/">VERDERER</a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={active === item.id ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <button id="theme-toggle" type="button" aria-label="Switch between light and dark theme">Theme</button>
      </div>
    </header>
    <main><div class="wrap"><slot /></div></main>
    <footer class="site">
      <div class="wrap">
        <div>
          Verderer attests only what its collector received: this response, from this address, at this time —
          preserved faithfully and verifiable offline. Labels such as severity and change type are a best-effort,
          human-reviewable interpretation, never a verified fact.
          <a href="/guide#proof">What is and isn't proven →</a>
        </div>
        <div class="links">
          <a href="/feed.xml">RSS feed</a>
          <a href="/record.json">record.json</a>
          <a href="/checkpoint">Signed checkpoint</a>
          <a href="/verify">Verify a proof</a>
          <a href="https://github.com/satchmakua/verderer">Source code</a>
        </div>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;

        // Theme toggle: follows the system until chosen; the choice is a per-reader convenience.
        const toggle = document.getElementById('theme-toggle');
        const current = () =>
          root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const label = () => { if (toggle) toggle.textContent = current() === 'dark' ? 'Light theme' : 'Dark theme'; };
        label();
        toggle?.addEventListener('click', () => {
          const next = current() === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('verderer-theme', next); } catch {}
          label();
        });

        // Relative times. The server prints an absolute UTC date; a recent one reads better
        // as "3 hours ago", and every one gets the reader's local time on hover.
        const UNITS = [['year', 31536000], ['month', 2592000], ['week', 604800], ['day', 86400], ['hour', 3600], ['minute', 60]];
        const rtf = new Intl.RelativeTimeFormat('en', { numeric: 'auto' });
        const relative = (date) => {
          const seconds = (date.getTime() - Date.now()) / 1000;
          for (const [unit, size] of UNITS) {
            if (Math.abs(seconds) >= size) return rtf.format(Math.round(seconds / size), unit);
          }
          return 'just now';
        };
        const RECENT = 14 * 86400 * 1000;

        function refresh() {
          for (const el of document.querySelectorAll('time[datetime]')) {
            const date = new Date(el.getAttribute('datetime'));
            if (Number.isNaN(date.getTime())) continue;
            if (!el.dataset.abs) el.dataset.abs = el.textContent;
            el.title = `${date.toLocaleString()} your time · ${el.dataset.abs}`;
            const mode = el.dataset.rel;
            if (mode === 'always' || (mode === 'recent' && Math.abs(Date.now() - date.getTime()) < RECENT)) {
              el.textContent = relative(date);
            }
          }
          // Is the watchdog still running? The record carries when it was generated; if that
          // is long ago, say so plainly instead of presenting stale data as current.
          for (const el of document.querySelectorAll('[data-freshness]')) {
            const date = new Date(el.dataset.generated || '');
            if (Number.isNaN(date.getTime())) continue;
            const hours = (Date.now() - date.getTime()) / 3600000;
            const tone = hours < 15 ? 'ok' : hours < 36 ? 'warn' : 'bad';
            el.dataset.tone = tone;
            const title = el.querySelector('[data-fresh-label]');
            const detail = el.querySelector('[data-fresh-detail]');
            if (title) title.textContent = tone === 'ok' ? 'Watchdog running' : tone === 'warn' ? 'Watchdog delayed' : 'Watchdog stalled';
            if (detail) {
              detail.textContent =
                tone === 'ok'
                  ? `Last run ${relative(date)}. Sources are re-checked several times a day.`
                  : tone === 'warn'
                    ? `Last run ${relative(date)} — later than usual. The record below is still accurate as of then.`
                    : `No completed run since ${relative(date)}. Everything below is accurate only as of that run.`;
            }
          }
        }
        refresh();
        setInterval(refresh, 60000);

        // Copy a full hash/key that is shown shortened.
        document.addEventListener('click', (event) => {
          const button = event.target instanceof Element ? event.target.closest('[data-copy]') : null;
          if (!button || !navigator.clipboard) return;
          navigator.clipboard.writeText(button.getAttribute('data-copy') || '').then(() => {
            const before = button.textContent;
            button.textContent = 'Copied';
            setTimeout(() => { button.textContent = before; }, 1200);
          });
        });
      })();
    </script>
  </body>
</html>
