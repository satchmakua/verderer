# --- Base ignores (stack-agnostic) ---

# Secrets / local env — never commit real ones (see .env.example)
.env
.env.*
!.env.example
*.local


# Editor / OS cruft
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.DS_Store
Thumbs.db
*.log

# Generic build / cache output
dist/
build/
out/
coverage/
.cache/
tmp/
*.tmp

# --- Stack-specific ---

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Verderer runtime state — blobs, ledger, and the local signing key. Never commit.
verderer-data/
annals-data/
# Legacy pre-rename runtime state (kept locally; not auto-migrated)
druid-data/

# Rust build output (Cargo.lock IS committed for the binaries — reproducible builds)
rust/target/

# Web (Astro) build output + deps
web/node_modules/
web/dist/
web/.astro/
site-data/

# Generated WASM verifier (rebuild with `npm --prefix web run build:wasm`)
# web/public/wasm/ committed for CI reproducibility (rebuild via npm run build:wasm when ledger-core changes)

# Per-deploy export artifacts: regenerated by `verderer export` + `verderer bundle`, published
# on the gh-pages branch — never committed to main (the dataset bundle alone is ~38 MB).
web/public/bundles/
web/public/warc/

# --- OTS fixtures: keep them (they are the M13b anchor), do not let the blob ignores hide them
!tests/fixtures/ots/
